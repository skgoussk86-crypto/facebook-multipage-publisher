{
  "name": "facebook-multipage-publisher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "create-admin": "tsx scripts/create-admin.ts",
    "reset-admin": "tsx scripts/reset-admin.ts",
    "worker": "node --conditions=react-server --import tsx scripts/run-production-worker.ts",
    "worker:once": "node --conditions=react-server --import tsx scripts/run-worker-once.ts",
    "test:worker": "node --conditions=react-server --import tsx scripts/run-worker-runtime-tests.ts",
    "build:prod": "next build",
    "start:prod": "next start -H 127.0.0.1 -p 3000",
    "check:prod": "prisma validate && prisma migrate status && prisma generate && npm run lint && npm run build",
    "test": "tsx scripts/run-auth-tests.ts",
    "test:google-drive": "node --conditions=react-server --import tsx scripts/run-google-drive-oauth-tests.ts",
    "test:google-drive-folder": "node --conditions=react-server --import tsx scripts/run-google-drive-folder-tests.ts",
    "test:google-drive-connection-repository": "node --conditions=react-server --import tsx scripts/run-google-drive-connection-repository-tests.ts",
    "test:google-drive-folder-provisioning": "node --conditions=react-server --import tsx scripts/run-google-drive-folder-provisioning-tests.ts",
    "test:google-drive-callback-folder": "node --conditions=react-server --import tsx scripts/run-google-drive-callback-folder-tests.ts",
    "test:google-drive-media-client": "node --conditions=react-server --import tsx scripts/run-google-drive-media-client-tests.ts",
    "test:google-drive-upload-initiation": "node --conditions=react-server --import tsx scripts/run-google-drive-upload-initiation-tests.ts",
    "test:google-drive-upload-completion": "node --conditions=react-server --import tsx scripts/run-google-drive-upload-completion-tests.ts",
    "test:google-drive-video-validation": "node --conditions=react-server --import tsx scripts/run-google-drive-video-validation-tests.ts",
    "test:google-drive-browser-upload": "node --conditions=react-server --import tsx scripts/run-google-drive-browser-upload-tests.ts",
    "test:gemini-foundation": "node --conditions=react-server --import tsx scripts/run-gemini-foundation-tests.ts",
    "test:gemini-video-analysis": "node --conditions=react-server --import tsx scripts/run-gemini-video-analysis-tests.ts",
    "test:gemini-analysis-api": "node --conditions=react-server --import tsx scripts/run-gemini-analysis-api-tests.ts",
    "test:gemini-dashboard-analysis": "node --conditions=react-server --import tsx scripts/run-gemini-dashboard-analysis-tests.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@google/genai": "2.12.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^10.9.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
