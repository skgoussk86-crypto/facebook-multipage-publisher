# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/fb_publisher?schema=public"

# NextAuth Dashboard Auth Configuration
NEXTAUTH_SECRET="use_a_cryptographically_secure_random_string_here_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# Meta Facebook App Credentials
FACEBOOK_APP_ID="your_facebook_app_id_here"
FACEBOOK_APP_SECRET="your_facebook_app_secret_here"

# Secure Token Encryption Key (AES-256-GCM)
# Generate using: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="your_64_character_hex_encryption_key_here"

# Google Cloud Services Credentials (Staging/Production)
GCP_PROJECT_ID="your-gcp-project-id"
GCS_BUCKET_NAME="your-gcs-media-bucket"
CLOUD_TASKS_QUEUE_NAME="projects/your-gcp-project-id/locations/us-central1/queues/fb-publisher-queue"
PUBLISHING_WORKER_URL="https://your-publishing-worker-url.run.app/api/worker/publish"

# Live Meta API Mode Feature Flag (defaults to false)
LIVE_META_MODE=false

# Cloudflare R2 Storage Configuration (Phase 4)
STORAGE_PROVIDER=R2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_PRESIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=524288000
UPLOAD_PART_SIZE_BYTES=10485760
UPLOAD_SESSION_ENCRYPTION_KEY=
UPLOAD_SESSION_ENCRYPTION_KEY_VERSION=1

# Google Drive Per-User OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/google-drive/callback
GOOGLE_DRIVE_FOLDER_NAME=Facebook Multi-Page Publisher
GOOGLE_DRIVE_TOKEN_KEY_VERSION=1

# Google Drive Owner-Scoped OAuth Configuration (Step 4C-2)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://your-domain.com/api/auth/google-drive/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_STORAGE_OWNER_USER_ID=

# ffprobe executable path override (optional, defaults to 'ffprobe')
# FFPROBE_PATH="C:\path\to\ffprobe.exe"

# Background Worker Scheduler Config (Phase 6A)
# Set to 'true' to enable the background daemon worker process
WORKER_ENABLED=false
# Stable unique UUID for each worker instance. Must be a valid UUID.
WORKER_ID=
# Polling and error recovery sleep intervals (in milliseconds)
WORKER_POLL_INTERVAL_MS=10000
WORKER_ERROR_BACKOFF_MS=30000

# Emergency manual trigger worker endpoint. Disabled by default in production.
ENABLE_PRODUCTION_WORKER_ROUTE=false

# AI Content Automation Configuration (Phase 6M)
# Supported values: OLLAMA, GEMINI. Required; application fails closed when omitted.
AI_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct
OLLAMA_FRAME_COUNT=10
OLLAMA_REQUEST_TIMEOUT_MS=240000
OLLAMA_MAX_CONCURRENCY=1

# Gemini content and thumbnail automation
# Keep disabled until a private server-side API key is configured.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_VIDEO_BYTES=524288000
GEMINI_ANALYSIS_TIMEOUT_MS=180000
GEMINI_FILE_POLL_INTERVAL_MS=5000
# Permanent thumbnail generation and Google Drive storage
# FFMPEG_PATH defaults to "ffmpeg" when omitted.
# FFMPEG_PATH="C:\path\to\ffmpeg.exe"
THUMBNAIL_EXTRACTION_TIMEOUT_MS=60000
THUMBNAIL_MAX_SOURCE_BYTES=524288000
THUMBNAIL_MAX_BYTES=10485760
THUMBNAIL_MAX_WIDTH=1280
THUMBNAIL_JPEG_QUALITY=2

# Meta regular-video custom thumbnail publishing.
# Disabled by default. Reels always use Meta automatic cover selection.
# Production mode uses the multipart `thumb` field that passed the controlled
# live Page test, but Meta does not document this parameter in the current
# public regular-video publishing reference. Keep the acknowledgement explicit.
FACEBOOK_VIDEO_THUMBNAIL_PUBLISHING_MODE=disabled
# Production values:
# FACEBOOK_VIDEO_THUMBNAIL_PUBLISHING_MODE=production_regular_video_thumb
# FACEBOOK_VIDEO_THUMBNAIL_PUBLISHING_ACK=I_ACCEPT_META_REGULAR_VIDEO_THUMBNAIL_PRODUCTION_USE
FACEBOOK_VIDEO_THUMBNAIL_PUBLISHING_ACK=
# Controlled-probe values remain available for one exact job and Page for no
# more than 15 minutes:
# FACEBOOK_VIDEO_THUMBNAIL_PUBLISHING_MODE=experimental_regular_video_thumb
# FACEBOOK_VIDEO_THUMBNAIL_PUBLISHING_ACK=I_UNDERSTAND_META_THUMBNAIL_API_IS_UNVERIFIED
FACEBOOK_VIDEO_THUMBNAIL_PROBE_JOB_ID=
FACEBOOK_VIDEO_THUMBNAIL_PROBE_PAGE_ID=
FACEBOOK_VIDEO_THUMBNAIL_PROBE_EXPIRES_AT=
