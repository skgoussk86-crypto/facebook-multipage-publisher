datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  DRAFT
  MEDIA_UPLOADED
  SCHEDULED
  PREPARING
  UPLOADING_TO_META
  META_PROCESSING
  PUBLISHING
  PUBLISHED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED
  FACEBOOK_RECONNECT_REQUIRED
  /// Legacy terminal status. New code must never write this value.
  FAILED
}

enum MockScenario {
  SUCCESS
  TEMPORARY_NETWORK_FAILURE
  META_PROCESSING_DELAY
  META_RATE_LIMIT
  INVALID_MEDIA_FORMAT
  REVOKED_FACEBOOK_TOKEN
  MISSING_FACEBOOK_PERMISSION
  PERMANENT_PUBLISHING_FAILURE
}

enum FailureClassification {
  NETWORK_ERROR
  RATE_LIMIT
  INVALID_MEDIA
  REVOKED_TOKEN
  MISSING_PERMISSION
  UNKNOWN_ERROR
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  email            String             @unique @db.VarChar(255)
  passwordHash     String
  name             String?            @db.VarChar(255)
  role             UserRole           @default(USER)
  status           UserStatus         @default(ACTIVE)
  approvalStatus   UserApprovalStatus @default(PENDING)
  approvedAt       DateTime?          @db.Timestamptz
  approvedById     String?            @db.Uuid
  approvedBy       User?              @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers    User[]             @relation("UserApprovals")
  rejectedAt       DateTime?          @db.Timestamptz
  rejectionReason  String?            @db.Text
  registrationIp   String?            @db.VarChar(45)
  lastLoginAt      DateTime?          @db.Timestamptz
  facebookAccounts FacebookAccount[]
  appConfiguration AppConfiguration?
  facebookPages    FacebookPage[]
  videoJobs        VideoJob[]
  auditLogs        AuditLog[]
  uploadAssets     UploadAsset[]
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz

  @@index([approvedById])
}

model FacebookAccount {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @db.Uuid
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  facebookUserId       String         @db.VarChar(255)
  encryptedAccessToken String         @db.Text
  tokenExpiresAt       DateTime       @db.Timestamptz
  name                 String         @db.VarChar(255)
  pages                FacebookPage[]
  createdAt            DateTime       @default(now()) @db.Timestamptz
  updatedAt            DateTime       @updatedAt @db.Timestamptz

  @@unique([userId, facebookUserId])
  @@index([facebookUserId])
  @@index([userId])
}

model FacebookPage {
  id                 String          @id @default(uuid()) @db.Uuid
  accountId          String          @db.Uuid
  facebookAccount    FacebookAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  facebookPageId     String          @db.VarChar(255)
  pageName           String          @db.VarChar(255)
  pageCategory       String          @db.VarChar(255)
  pagePictureUrl     String          @db.Text
  encryptedPageToken String          @db.Text
  isSynced           Boolean         @default(true)
  videoJobs          VideoJob[]
  userId             String          @db.Uuid
  user               User            @relation(fields: [userId], references: [id])
  createdAt          DateTime        @default(now()) @db.Timestamptz
  updatedAt          DateTime        @updatedAt @db.Timestamptz

  @@unique([userId, facebookPageId])
  @@index([facebookPageId])
  @@index([accountId])
  @@index([userId])
}

model VideoJob {
  id                    String                 @id @default(uuid()) @db.Uuid
  pageId                String                 @db.Uuid
  facebookPage          FacebookPage           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  gcsVideoUri           String?                @db.Text
  storageUri            String?                @db.Text
  gcsThumbnailUri       String?                @db.Text
  englishTitle          String                 @db.VarChar(255)
  englishCaption        String                 @db.Text
  hashtags              String?                @db.Text
  scheduledTimeUTC      DateTime               @db.Timestamptz
  status                JobStatus              @default(DRAFT)
  contentType           String                 @default("VIDEO") @db.VarChar(50)
  metaPostId            String?                @db.VarChar(255)
  cloudTaskName         String?                @db.Text
  retryCount            Int                    @default(0) @db.Integer
  maxAttempts           Int                    @default(3) @db.Integer
  attemptCount          Int                    @default(0) @db.Integer
  lastErrorCode         String?                @db.VarChar(255)
  lastErrorMessage      String?                @db.Text
  failureClassification FailureClassification?
  providerReference     String?                @db.Text
  providerProcessingId  String?                @db.Text
  mockScenario          MockScenario?
  attempts              Json?                  @db.JsonB
  lockToken             String?                @db.Uuid
  lockedAt              DateTime?              @db.Timestamptz
  lockExpiresAt         DateTime?              @db.Timestamptz
  nextAttemptAt         DateTime?              @db.Timestamptz
  startedAt             DateTime?              @db.Timestamptz
  completedAt           DateTime?              @db.Timestamptz
  failedAt              DateTime?              @db.Timestamptz
  errorLog              String?                @db.Text
  userId                String                 @db.Uuid
  user                  User                   @relation(fields: [userId], references: [id])
  uploadAssetId         String?                @db.Uuid
  uploadAsset           UploadAsset?           @relation(fields: [uploadAssetId], references: [id], onDelete: Restrict)
  createdAt             DateTime               @default(now()) @db.Timestamptz
  updatedAt             DateTime               @updatedAt @db.Timestamptz

  @@index([status])
  @@index([scheduledTimeUTC])
  @@index([pageId])
  @@index([userId])
  @@index([uploadAssetId])
}

model AppConfiguration {
  id                 String   @id @default("default") @db.VarChar(50)
  publicAppUrl       String   @db.Text
  facebookAppId      String   @db.VarChar(255)
  encryptedAppSecret String   @db.Text
  liveMetaMode       Boolean  @default(false)
  userId             String?  @unique @db.Uuid
  user               User?    @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(255)
  details   String   @db.Text
  ipAddress String?  @db.VarChar(45)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
}

enum StorageProvider {
  R2
}

enum UploadFinalizationOperation {
  COMPLETE
  ABORT
}

enum UploadStatus {
  REQUESTED
  UPLOADING
  UPLOADED
  VALIDATING
  VALIDATED
  FAILED
  ABORTED
  EXPIRED
  OBJECT_DELETED
}

model UploadAsset {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @db.Uuid
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider           StorageProvider @default(R2)
  bucket             String          @db.VarChar(255)
  objectKey          String          @db.VarChar(512)
  originalName       String          @db.VarChar(255)
  expectedSize       BigInt          @db.BigInt
  actualSize         BigInt?         @db.BigInt
  declaredMimeType   String          @db.VarChar(100)
  detectedMimeType   String?         @db.VarChar(100)
  checksum           String?         @db.VarChar(255)
  objectETag         String?         @db.VarChar(255)
  status             UploadStatus    @default(REQUESTED)
  failureCode        String?         @db.VarChar(100)
  failureMessage     String?         @db.Text
  idempotencyKey     String          @db.VarChar(255)
  requestFingerprint String          @db.VarChar(64)

  // Validation lease locking fields
  validationLockToken     String?   @db.Uuid
  validationLockedAt      DateTime? @db.Timestamptz
  validationLockExpiresAt DateTime? @db.Timestamptz
  validationAttemptCount  Int       @default(0) @db.Integer
  validationMaxAttempts   Int       @default(3) @db.Integer
  validationStartedAt     DateTime? @db.Timestamptz

  // Finalization concurrency claim fields
  finalizationOperation     UploadFinalizationOperation?
  finalizationLockToken     String?                      @db.Uuid
  finalizationLockedAt      DateTime?                    @db.Timestamptz
  finalizationLockExpiresAt  DateTime?                    @db.Timestamptz
  finalizationAttemptCount   Int                          @default(0) @db.Integer

  // Media metadata fields
  durationMs      Int?    @db.Integer
  containerFormat String? @db.VarChar(50)
  videoCodec      String? @db.VarChar(50)
  audioCodec      String? @db.VarChar(50)
  width           Int?    @db.Integer
  height          Int?    @db.Integer
  frameRate       Float?

  uploadExpiresAt DateTime  @db.Timestamptz
  uploadedAt      DateTime? @db.Timestamptz
  validatedAt     DateTime? @db.Timestamptz
  retentionUntil  DateTime? @db.Timestamptz
  objectDeletedAt DateTime? @db.Timestamptz

  videoJobs      VideoJob[]
  uploadAttempts UploadAttempt[]
  uploadSession  UploadSession?
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  @@unique([userId, idempotencyKey])
  @@unique([provider, bucket, objectKey])
  @@index([userId, status])
  @@index([status, uploadExpiresAt])
  @@index([status, retentionUntil])
  @@index([status, validationLockExpiresAt])
  @@index([status, finalizationLockExpiresAt])
  @@index([finalizationOperation, finalizationLockExpiresAt])
}

model UploadAttempt {
  id            String      @id @default(uuid()) @db.Uuid
  uploadAssetId String      @db.Uuid
  uploadAsset   UploadAsset @relation(fields: [uploadAssetId], references: [id], onDelete: Restrict)
  attemptNumber Int         @db.Integer
  status        String      @db.VarChar(50)
  errorLog      String?     @db.Text
  createdAt     DateTime    @default(now()) @db.Timestamptz

  @@unique([uploadAssetId, attemptNumber])
  @@index([uploadAssetId, createdAt])
}

model UploadSession {
  uploadAssetId              String      @id @db.Uuid
  uploadAsset                UploadAsset @relation(fields: [uploadAssetId], references: [id], onDelete: Restrict)
  encryptionKeyVersion       String      @db.VarChar(50)
  encryptedProviderSessionId String      @db.Text
  encryptedCompletedParts    String      @db.Text
  expiresAt                  DateTime    @db.Timestamptz
  lastActivityAt             DateTime    @db.Timestamptz
  createdAt                  DateTime    @default(now()) @db.Timestamptz
  updatedAt                  DateTime    @updatedAt @db.Timestamptz
}
