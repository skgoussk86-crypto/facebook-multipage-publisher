datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  DRAFT
  MEDIA_UPLOADED
  SCHEDULED
  PREPARING
  UPLOADING_TO_META
  META_PROCESSING
  PUBLISHING
  PUBLISHED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED
  FACEBOOK_RECONNECT_REQUIRED
  /// Legacy terminal status. New code must never write this value.
  FAILED
}

enum MockScenario {
  SUCCESS
  TEMPORARY_NETWORK_FAILURE
  META_PROCESSING_DELAY
  META_RATE_LIMIT
  INVALID_MEDIA_FORMAT
  REVOKED_FACEBOOK_TOKEN
  MISSING_FACEBOOK_PERMISSION
  PERMANENT_PUBLISHING_FAILURE
}

enum FailureClassification {
  NETWORK_ERROR
  RATE_LIMIT
  INVALID_MEDIA
  REVOKED_TOKEN
  MISSING_PERMISSION
  UNKNOWN_ERROR
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  email            String             @unique @db.VarChar(255)
  passwordHash     String
  name             String?            @db.VarChar(255)
  role             UserRole           @default(USER)
  status           UserStatus         @default(ACTIVE)
  approvalStatus   UserApprovalStatus @default(PENDING)
  approvedAt       DateTime?          @db.Timestamptz
  approvedById     String?            @db.Uuid
  approvedBy       User?              @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers    User[]             @relation("UserApprovals")
  rejectedAt       DateTime?          @db.Timestamptz
  rejectionReason  String?            @db.Text
  registrationIp   String?            @db.VarChar(45)
  lastLoginAt      DateTime?          @db.Timestamptz
  facebookAccounts FacebookAccount[]
  appConfiguration AppConfiguration?
  facebookPages    FacebookPage[]
  videoJobs        VideoJob[]
  auditLogs        AuditLog[]
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz

  @@index([approvedById])
}

model FacebookAccount {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @db.Uuid
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  facebookUserId       String         @db.VarChar(255)
  encryptedAccessToken String         @db.Text
  tokenExpiresAt       DateTime       @db.Timestamptz
  name                 String         @db.VarChar(255)
  pages                FacebookPage[]
  createdAt            DateTime       @default(now()) @db.Timestamptz
  updatedAt            DateTime       @updatedAt @db.Timestamptz

  @@unique([userId, facebookUserId])
  @@index([facebookUserId])
  @@index([userId])
}

model FacebookPage {
  id                 String          @id @default(uuid()) @db.Uuid
  accountId          String          @db.Uuid
  facebookAccount    FacebookAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  facebookPageId     String          @db.VarChar(255)
  pageName           String          @db.VarChar(255)
  pageCategory       String          @db.VarChar(255)
  pagePictureUrl     String          @db.Text
  encryptedPageToken String          @db.Text
  isSynced           Boolean         @default(true)
  videoJobs          VideoJob[]
  userId             String          @db.Uuid
  user               User            @relation(fields: [userId], references: [id])
  createdAt          DateTime        @default(now()) @db.Timestamptz
  updatedAt          DateTime        @updatedAt @db.Timestamptz

  @@unique([userId, facebookPageId])
  @@index([facebookPageId])
  @@index([accountId])
  @@index([userId])
}

model VideoJob {
  id                    String                 @id @default(uuid()) @db.Uuid
  pageId                String                 @db.Uuid
  facebookPage          FacebookPage           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  gcsVideoUri           String                 @db.Text
  gcsThumbnailUri       String?                @db.Text
  englishTitle          String                 @db.VarChar(255)
  englishCaption        String                 @db.Text
  hashtags              String?                @db.Text
  scheduledTimeUTC      DateTime               @db.Timestamptz
  status                JobStatus              @default(DRAFT)
  contentType           String                 @default("VIDEO") @db.VarChar(50)
  metaPostId            String?                @db.VarChar(255)
  cloudTaskName         String?                @db.Text
  retryCount            Int                    @default(0) @db.Integer
  maxAttempts           Int                    @default(3) @db.Integer
  attemptCount          Int                    @default(0) @db.Integer
  lastErrorCode         String?                @db.VarChar(255)
  lastErrorMessage      String?                @db.Text
  failureClassification FailureClassification?
  providerReference     String?                @db.Text
  providerProcessingId  String?                @db.Text
  mockScenario          MockScenario?
  attempts              Json?                  @db.JsonB
  lockToken             String?                @db.Uuid
  lockedAt              DateTime?              @db.Timestamptz
  lockExpiresAt         DateTime?              @db.Timestamptz
  nextAttemptAt         DateTime?              @db.Timestamptz
  startedAt             DateTime?              @db.Timestamptz
  completedAt           DateTime?              @db.Timestamptz
  failedAt              DateTime?              @db.Timestamptz
  errorLog              String?                @db.Text
  userId                String                 @db.Uuid
  user                  User                   @relation(fields: [userId], references: [id])
  createdAt             DateTime               @default(now()) @db.Timestamptz
  updatedAt             DateTime               @updatedAt @db.Timestamptz

  @@index([status])
  @@index([scheduledTimeUTC])
  @@index([pageId])
  @@index([userId])
}

model AppConfiguration {
  id                 String   @id @default("default") @db.VarChar(50)
  publicAppUrl       String   @db.Text
  facebookAppId      String   @db.VarChar(255)
  encryptedAppSecret String   @db.Text
  liveMetaMode       Boolean  @default(false)
  userId             String?  @unique @db.Uuid
  user               User?    @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(255)
  details   String   @db.Text
  ipAddress String?  @db.VarChar(45)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
}
